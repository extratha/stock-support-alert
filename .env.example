# --- LINE Messaging API (LINE Developers Console > your channel) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Stock data: Twelve Data free API key (https://twelvedata.com) ---
STOCK_API_KEY=

# --- Postgres connection string (Supabase: Project Settings > Database > Connection pooling) ---
DATABASE_URL=

# --- Protects the web UI (HTTP Basic, any username) — REQUIRED in production ---
ADMIN_PASSWORD=
# --- Shared secret between GitHub Actions and /api/cron/* — REQUIRED (e.g. `openssl rand -hex 32`) ---
CRON_SECRET=

# --- Optional ---
# Max friends that receive push alerts (each push counts once per recipient against LINE's monthly quota).
# Other friends can still ask "ขอแนวรับ" (replies are free). Managed on the web UI: "ผู้รับแจ้งเตือน".
MAX_PUSH_RECIPIENTS=5
# Max tracked symbols (default 20). Lists longer than API_CREDITS_PER_MINUTE are fetched in batches.
MAX_TRACKED_SYMBOLS=20
# Symbols fetched per API call = Twelve Data credits per minute (free plan: 8)
API_CREDITS_PER_MINUTE=8
# Reuse a cached quote younger than this many minutes
QUOTE_CACHE_TTL_MINUTES=5
