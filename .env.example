# --- LINE Messaging API (LINE Developers Console > your channel) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Stock data: Twelve Data free API key (https://twelvedata.com) ---
STOCK_API_KEY=

# --- Live prices shown on the dashboard only (alerts still use Twelve Data). Free key: https://finnhub.io
# Optional: without it (or if it fails) the page falls back to Yahoo, then to the price saved by the last scheduled check.
FINNHUB_API_KEY=
# Live prices are cached in the DB and shared by every user/instance, so reloading never multiplies API calls
LIVE_PRICE_TTL_SECONDS=300
# The "รีเฟรชราคา" button bypasses that cache, but not more often than this per symbol
LIVE_PRICE_MIN_REFRESH_SECONDS=30
# Max time for one live-price request (all symbols, all sources); after that stored prices are used
LIVE_PRICE_DEADLINE_MS=12000

# --- Postgres connection string (Supabase: Project Settings > Database > Connection pooling) ---
DATABASE_URL=

# --- Web UI login (username + password form) — ADMIN_PASSWORD and SESSION_SECRET REQUIRED in production ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the login cookie, >= 16 chars (e.g. `openssl rand -hex 32`). Changing it (or the username/password) signs everyone out.
SESSION_SECRET=
# --- Shared secret between GitHub Actions and /api/cron/* — REQUIRED (e.g. `openssl rand -hex 32`) ---
CRON_SECRET=

# --- Optional ---
# Max friends that receive push alerts (each push counts once per recipient against LINE's monthly quota).
# Other friends can still ask "ขอแนวรับ" (replies are free). Managed on the web UI: "ผู้รับแจ้งเตือน".
MAX_PUSH_RECIPIENTS=5
# Max tracked symbols (default 20). Lists longer than API_CREDITS_PER_MINUTE are fetched in batches.
MAX_TRACKED_SYMBOLS=20
# Symbols fetched per API call = Twelve Data credits per minute (free plan: 8)
API_CREDITS_PER_MINUTE=8
# Reuse a cached quote younger than this many minutes
QUOTE_CACHE_TTL_MINUTES=5
# Which support tiers send LINE alerts (default: major only — the one tier the backtest found better than a random day)
ALERT_TIERS=major

# --- AI stock ranking (the "วิเคราะห์ด้วย AI" tab). Any OpenAI-compatible provider. Optional: without them the tab says it is not set up.
# AI_API_KEY is a secret (in Vercel choose "Secret"). Free tiers change often; check the provider's page.
AI_API_KEY=
# one model, or several separated by commas: the first is the default, the others are tried in order when it cannot be used
AI_MODEL=
# default https://openrouter.ai/api/v1 · Gemini: https://generativelanguage.googleapis.com/v1beta/openai · Groq: https://api.groq.com/openai/v1
AI_BASE_URL=
# runs per New York day, failed ones included (each costs quota with the provider)
AI_DAILY_LIMIT=10
# AI_TIMEOUT_SECONDS=280   (default and max; the route may run 300 s on Vercel with Fluid compute)
# AI_TEMPERATURE=   (sent only when set; some models reject anything but their default)

# --- News brief (the "ข่าว" tab): free Finnhub news (FINNHUB_API_KEY) summarised by the AI above. All optional.
# briefs per New York day, the scheduled pre-market one included
NEWS_DAILY_LIMIT=3
# most articles per stock the AI reads
NEWS_PER_STOCK=6
# characters of article text per brief (~4 per token); lower it for a provider with a small per-minute token limit (Groq free)
NEWS_PROMPT_MAX_CHARS=160000
